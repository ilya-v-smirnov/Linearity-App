linters: linters_with_defaults(
    indentation_linter = NULL,
    line_length_linter = line_length_linter(120L),
    quotes_linter = NULL,
    object_name_linter = object_name_linter(styles = c("snake_case", "dotted.case", "UPPERCASE")),
    commented_code_linter = NULL
  )
exclusions: list(
    "tests" = list(object_usage_linter = Inf)
  )
encoding: "UTF-8"
